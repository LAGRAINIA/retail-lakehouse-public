# Copy to .env and fill in (never commit .env). Astro injects it in every Airflow container.
# Databricks Free Edition:
#   host       -> the URL of your workspace, without https://  (xxxx.cloud.databricks.com)
#   http_path  -> SQL Warehouses > your warehouse > Connection details > HTTP path
#   token      -> Settings > Developer > Access tokens > Generate new token
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=retail

# First day of simulated history
RETAIL_EPOCH=2026-07-01

# Generated from the values above by: python scripts/sync_airflow_connection.py
AIRFLOW_CONN_DATABRICKS_DEFAULT=
